{
  "description": "Учебный доступ: эталон недоступен агенту; разрешены только файлы упражнения и ограниченные команды.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/guard_reference.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/tools/guard_reference.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
